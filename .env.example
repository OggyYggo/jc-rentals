NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_ALERT_EMAIL=
RESEND_TEMPLATE_ID=
NOTIFY_WEBHOOK_SECRET=
CRON_SECRET=
# Set this value for the Production environment in Vercel.
NEXT_PUBLIC_SITE_URL=https://kuyogbohol.app
# Optional comma-separated HTTPS origins recognized by the pickup scanner in previews.
PICKUP_PREVIEW_ORIGINS=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CONTACT_INBOX_EMAIL=kuyogbohol@gmail.com

# Server-only key used by private storage operations and the database health probe.
SUPABASE_SECRET_KEY=
# QuickPay owner top-ups. Use a sandbox database and a test key with Read and Checkouts scopes.
QUICKPAY_ENABLED=
QUICKPAY_BASE_URL=https://quickpayph.com/api/v1
QUICKPAY_API_KEY=
QUICKPAY_WEBHOOK_SECRET=
QUICKPAY_TOPUP_MAX=5000
# Optional Sentry error reporting. Set the public DSN at build time for browser reporting.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Use 0 for a preview deployment that collects reports without enforcement.
CSP_ENFORCE=1
